          }
        ],
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Batch result', () => { const r = pm.response.json(); pm.expect(r.status).to.equal('cancelled'); pm.expect(r.progress).to.equal(25); pm.expect(r.reports.filter(x => x.status === 'cancelled').length).to.equal(3); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "12 Drain queue - verify preserved results",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/report-batches/{{secondBatch}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "report-batches",
            "{{secondBatch}}"
          ]
        },
