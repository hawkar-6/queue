      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Batch result', () => { const r = pm.response.json(); pm.expect(r.progress).to.equal(25); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "08 Register guest",
      "event": [
