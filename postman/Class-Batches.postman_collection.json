        "body": {
          "mode": "raw",
          "raw": "{\n  \"classes\": [\n    {\n      \"name\": \"A\",\n      \"scores\": [\n        60,\n        80,\n        100\n      ]\n    },\n    {\n      \"name\": \"B\",\n      \"scores\": [\n        70,\n        90\n      ]\n    },\n    {\n      \"name\": \"C\",\n      \"scores\": [\n        40,\n        50,\n        60\n      ]\n    },\n    {\n      \"name\": \"D\",\n      \"scores\": [\n        85,\n        95\n      ]\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 202', () => pm.response.to.have.status(202));",
              "if (pm.response.code === 202) pm.collectionVariables.set('secondBatch', pm.response.json().batch_id);",
              "pm.test('Batch result', () => { const r = pm.response.json(); pm.expect(r.progress).to.equal(0); });"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 Run ONE job - check 25%",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/report-batches/{{secondBatch}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
