          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('guestEmail', 'guest-' + pm.variables.replaceIn('{{$guid}}') + '@example.test');",
              "pm.collectionVariables.set('guestPass', pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.unset('guestToken');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "auth": {
          "type": "noauth"
