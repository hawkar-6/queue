    {
      "name": "10 Guest cannot cancel",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/report-batches/{{secondBatch}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "report-batches",
            "{{secondBatch}}",
            "cancel"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{guestToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 403', () => pm.response.to.have.status(403));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "11 Owner cancels",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/report-batches/{{secondBatch}}/cancel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "report-batches",
            "{{secondBatch}}",
            "cancel"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{ownerToken}}",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Accept",
