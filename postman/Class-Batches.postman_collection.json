              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Batch result', () => { const r = pm.response.json(); pm.expect(r.status).to.equal('cancelled'); pm.expect(r.progress).to.equal(25); pm.expect(r.reports.filter(x => x.status === 'cancelled').length).to.equal(3); pm.expect(r.reports[0].result.average).to.equal(80); });"
            ]
          }
        }
      ],
