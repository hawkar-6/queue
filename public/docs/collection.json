        {
            "name": "Class report batches",
            "description": "",
            "item": [
                {
                    "name": "Submit class reports\nEach class becomes one independent job on the class-reports queue.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/report-batches",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/report-batches"
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\"classes\":[{\"name\":\"Class A\",\"scores\":[60,80,100]}]}"
                        },
                        "description": ""
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 202,
                            "body": "{\"batch_id\":\"890b38a0-301c-4959-9a28-3592c39aec40\",\"status\":\"queued\",\"total\":1,\"completed\":0,\"progress\":0,\"reports\":[{\"id\":1,\"class_name\":\"Class A\",\"status\":\"queued\",\"result\":null}]}",
                            "name": ""
                        }
                    ]
                },
                {
                    "name": "Read progress and one result per class\nProgress counts ready reports, including after cancellation.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/report-batches\/:batch_id",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/report-batches\/:batch_id",
                            "variable": [
                                {
                                    "id": "batch_id",
                                    "key": "batch_id",
                                    "value": "890b38a0-301c-4959-9a28-3592c39aec40",
                                    "description": "Batch UUID."
                                }
                            ]
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": ""
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"batch_id\":\"890b38a0-301c-4959-9a28-3592c39aec40\",\"status\":\"ready\",\"total\":1,\"completed\":1,\"progress\":100,\"reports\":[{\"id\":1,\"class_name\":\"Class A\",\"status\":\"ready\",\"result\":{\"count\":3,\"average\":80,\"highest\":100,\"lowest\":60}}]}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 403,
                            "body": "{\"message\":\"This action is unauthorized.\"}",
                            "name": ""
                        }
                    ]
                },
                {
                    "name": "Cancel outstanding reports\nReady results are retained. Repeating a cancellation is safe.",
                    "request": {
                        "url": {
                            "host": "{{baseUrl}}",
                            "path": "api\/report-batches\/:batch_id\/cancel",
                            "query": [],
                            "raw": "{{baseUrl}}\/api\/report-batches\/:batch_id\/cancel",
                            "variable": [
                                {
                                    "id": "batch_id",
                                    "key": "batch_id",
                                    "value": "890b38a0-301c-4959-9a28-3592c39aec40",
                                    "description": "Batch UUID."
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": ""
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"batch_id\":\"890b38a0-301c-4959-9a28-3592c39aec40\",\"status\":\"cancelled\",\"total\":1,\"completed\":0,\"progress\":0,\"reports\":[{\"id\":1,\"class_name\":\"Class A\",\"status\":\"cancelled\",\"result\":null}]}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 403,
                            "body": "{\"message\":\"This action is unauthorized.\"}",
                            "name": ""
                        },
                        {
                            "header": [],
                            "code": 409,
                            "body": "{\"message\":\"This batch has already finished.\"}",
                            "name": ""
                        }
                    ]
                }
            ]
